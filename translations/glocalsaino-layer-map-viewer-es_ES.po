#. Plugin Name of the plugin
#: glocalsaino-layer-map-viewer.php
msgid "GlocalSaino Layer Map Viewer"
msgstr "GlocalSaino Layer Map Viewer"

#. Plugin URI of the plugin
#: glocalsaino-layer-map-viewer.php
msgid "https://glocalsaino.com/layermapviewer/"
msgstr "https://glocalsaino.com/layermapviewer/"

#. Description of the plugin
#: glocalsaino-layer-map-viewer.php
msgid "Upload one or more KML files and display interactive maps with colored layers, per-field filtering, and transparency control, with no limit on the number of maps."
msgstr "Sube uno o varios archivos KML y muestra mapas interactivos con capas de colores, filtro por campo y control de transparencia, sin límite de mapas."

#. Author of the plugin
#: glocalsaino-layer-map-viewer.php
msgid "Glocal Saino"
msgstr "Glocal Saino"

#: admin/admin-page.php:22
msgid "You must enter a name for the map."
msgstr "Debes escribir un nombre para el mapa."

#: admin/admin-page.php:23
msgid "You must select at least one KML file."
msgstr "Debes seleccionar al menos un archivo KML."

#: admin/admin-page.php:24
msgid "Files must have the .kml extension."
msgstr "Los archivos deben tener la extensión .kml."

#. translators: %s: maximum upload size, already formatted (e.g. "64 MB")
#: admin/admin-page.php:27
#, php-format
msgid "One or more files exceed the maximum upload size allowed by your hosting (%s). Ask whoever manages the server to increase upload_max_filesize/post_max_size, or split the KML into smaller files."
msgstr "Uno o varios archivos superan el tamaño máximo de subida que permite tu alojamiento (%s). Pide a quien gestione el servidor que aumente upload_max_filesize/post_max_size, o divide el KML en archivos más pequeños."

#: admin/admin-page.php:30
msgid "This map's layer data could not be read, so nothing was changed to avoid losing your existing layers. Please contact support."
msgstr "No se han podido leer los datos de las capas de este mapa, así que no se ha cambiado nada para no perder tus capas actuales. Ponte en contacto con el soporte."

